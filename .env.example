# =============================================================================
# ScanbonAI – Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in real values before running.
#   cp .env.example .env
#
# Rules:
#   - Never commit the filled-in .env to version control.
#   - In Dokploy: paste each variable into the "Environment" tab and mark
#     all passwords / API keys as "Secret".
#   - Lines starting with # are comments and are ignored by Docker Compose.
# =============================================================================


# =============================================================================
# Database (PostgreSQL)
# =============================================================================

# Full async DSN used by SQLAlchemy / asyncpg inside the api and worker containers.
# Host must match the Compose service name ("db").
DATABASE_URL=postgresql+asyncpg://scanbonai:changeme@db:5432/scanbonai

# Credentials used by the `db` service to initialise the PostgreSQL cluster.
# Must match the username/password embedded in DATABASE_URL above.
POSTGRES_USER=scanbonai
POSTGRES_PASSWORD=changeme
POSTGRES_DB=scanbonai


# =============================================================================
# Redis
# =============================================================================

# Used as the Celery broker URL and result backend.
# Host must match the Compose service name ("redis").
REDIS_URL=redis://redis:6379/0


# =============================================================================
# WhatsApp Business API
# =============================================================================

# Long-lived system-user token from the Meta developer portal.
WHATSAPP_API_TOKEN=your_whatsapp_token

# Arbitrary string you choose; must match what you enter in the Meta webhook
# subscription form so the platform can verify ownership of your endpoint.
WHATSAPP_VERIFY_TOKEN=your_verify_token

# Numeric phone-number ID visible in the Meta business manager.
WHATSAPP_PHONE_NUMBER_ID=your_phone_id

# HMAC secret for validating incoming webhook payloads (X-Hub-Signature-256).
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret


# =============================================================================
# OCR – DeepSeek
# =============================================================================

# API key issued by DeepSeek for the OCR v2 endpoint.
DEEPSEEK_OCR_API_KEY=your_deepseek_key

# Override only if DeepSeek changes their base URL or you are using a proxy.
DEEPSEEK_OCR_API_URL=https://api.deepseek.com/v1


# =============================================================================
# Security
# =============================================================================

# HMAC secret for session cookies and magic-link tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-random-64-char-string

# Separate key scoped to signed image-access URLs, so it can be rotated
# independently of SECRET_KEY without invalidating user sessions.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SIGNING_KEY=change-this-to-different-random-string


# =============================================================================
# Admin Bootstrap
# =============================================================================

# Used by the create_admin script (Step 8 in DOKPLOY_DEPLOYMENT.md).
# Change immediately after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme


# =============================================================================
# Application Config
# =============================================================================

# Absolute path inside the container where invoice images are stored.
# Must match the bind-mount target in docker-compose.yml.
STORAGE_PATH=/data/invoices

# Comma-separated list of origins allowed by the FastAPI CORS middleware.
# Use your production domain (no trailing slash).
CORS_ORIGINS=https://your-domain.com

# Comma-separated list of hostnames the API will accept in the Host header.
ALLOWED_HOSTS=your-domain.com

# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Lifetime of signed image-access URLs in seconds (default: 86400 = 24 h).
SIGNED_URL_EXPIRY_SECONDS=86400

# Maximum accepted invoice image size in megabytes.
MAX_IMAGE_SIZE_MB=10


# =============================================================================
# Optional / Observability
# =============================================================================

# Sentry DSN for error tracking. Leave blank to disable.
SENTRY_DSN=


# =============================================================================
# FUTURE – uncomment when the corresponding services are deployed
# =============================================================================

# Expert-pool scoring worker
# EXPERT_POOL_ENABLED=false

# Payment provider (Stripe / PayFast / etc.)
# PAYMENT_PROVIDER_KEY=
# PAYMENT_WEBHOOK_SECRET=
